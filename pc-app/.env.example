# =============================================================================
# COPY THIS FILE to .env and fill in your own values.
#
#     cp .env.example .env
#
# .env is listed in .gitignore and must NEVER be committed.
# =============================================================================

# ---- Third box -------------------------------------------------------------
# The IP address the ESP32 prints on its OLED and serial port at boot.
# "thermobox.local" also works if your machine resolves mDNS (macOS yes,
# Windows only with Bonjour installed) -- an IP address is the reliable choice.
BOX_HOST=192.168.1.50
BOX_PORT=80

# Point this at the simulator instead, to develop with no hardware:
#   python tools/fake_box.py
# BOX_HOST=127.0.0.1
# BOX_PORT=8080

# ---- Alert delivery (Requirement 7) ----------------------------------------
# Alerts are sent as email. To reach a phone as an SMS instead, address the
# email to your carrier gateway and put THAT address in the UI recipient box:
#   Verizon   5551234567@vtext.com
#   AT&T      5551234567@txt.att.net
#   T-Mobile  5551234567@tmomail.net
#   US Cellular 5551234567@email.uscc.net
#
# For Gmail you must create an App Password (Google Account > Security >
# 2-Step Verification > App passwords). Your normal account password will not
# work and should never be pasted here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraccount@gmail.com
SMTP_PASSWORD=your-16-character-app-password
ALERT_FROM=youraccount@gmail.com
